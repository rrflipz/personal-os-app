# Copy this file to .env and fill in real values. Never commit .env to git.

# Required
JWT_SECRET=replace_with_a_long_random_string
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Connection string for your Postgres database. On Render, copy this from
# your Postgres instance's "Connections" tab (use the Internal Database URL
# if your web service and database are both on Render).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional but needed for the paywall to work
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_subscription_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional but needed for "forgot password" emails to actually send.
# From resend.com, after you've verified your domain there.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM="Personal OS <noreply@yourdomain.com>"

# The public URL of your deployed app (used for Stripe redirect links).
# When running locally this can stay as-is.
CLIENT_URL=http://localhost:3000

# How many free messages a new user gets before hitting the paywall
FREE_MESSAGE_LIMIT=15

# How many past messages get replayed to Claude on every chat turn, and how
# many get kept in the database at all. Both optional -- these are the
# defaults if you leave them out. Raising MAX_API_HISTORY gives the AI more
# context per reply but raises your Anthropic API cost per message as
# conversations get longer.
MAX_API_HISTORY=40
MAX_STORED_HISTORY=300

PORT=3000
